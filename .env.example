# Legacy BabyLoveGrowth sync (scripts/sync-blog.mjs)
BABYLOVE_API_KEY=your-key-from-babylovegrowth-dashboard

# Opinly blog — the Worker reads these from Cloudflare secrets in production and
# from .dev.vars in `wrangler dev`. Copy this file to .dev.vars for local work.
OPINLY_API_KEY=sk-your-content-api-key
OPINLY_WEBHOOK_SIGNING_SECRET=whsec_your-svix-signing-secret
